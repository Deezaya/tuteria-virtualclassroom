generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  tutor
  student
}

enum ClassRole {
  admin
  tutor
  student
  guest
  observer
}

enum ParticipantStatus {
  waiting
  admitted
  denied
  left
  removed
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String   @unique
  hashedPassword String?
  name           String
  role           UserRole @default(student)
  createdAt      DateTime @default(now())
  spaces         Space[]
  participants   Participant[]

  @@map("users")
}

model Space {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  creatorId         String   @db.Uuid
  creator           User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  inviteTokenHash   String   @unique
  observerTokenHash String   @unique
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime?
  sessions          Session[]
  chatMessages      ChatMessage[]

  @@index([creatorId])
  @@index([name])
  @@map("spaces")
}

model Session {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId      String        @db.Uuid
  space        Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  endedBy      String?       @db.Uuid
  defaultPermissions Json    @default("{\"editing\":true,\"microphone\":true,\"camera\":true,\"screenShare\":true,\"raiseHand\":true,\"reactions\":true,\"chat\":true,\"fileUploads\":true}")
  participants Participant[]
  chatMessages  ChatMessage[]
  breakoutRooms BreakoutRoom[]

  @@index([spaceId, endedAt])
  @@index([spaceId, startedAt])
  @@map("sessions")
}

model Participant {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String            @db.Uuid
  session     Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String?           @db.Uuid
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName String?
  classRole   ClassRole
  status      ParticipantStatus
  randomId    String?           @unique
  joinedAt    DateTime          @default(now())
  admittedAt  DateTime?
  leftAt      DateTime?
  permissions Json @default("{\"editing\":true,\"microphone\":true,\"camera\":true,\"screenShare\":true,\"raiseHand\":true,\"reactions\":true,\"chat\":true,\"fileUploads\":true}")
  breakoutRoomId String?      @db.Uuid
  breakoutRoom   BreakoutRoom? @relation(fields: [breakoutRoomId], references: [id], onDelete: SetNull)
  chatMessages ChatMessage[]

  @@index([sessionId, status])
  @@index([sessionId, status, joinedAt])
  @@index([userId])
  @@index([breakoutRoomId])
  @@map("participants")
}

model BreakoutRoom {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String        @db.Uuid
  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime      @default(now())
  members   Participant[]

  @@index([sessionId])
  @@map("breakout_rooms")
}

model Board {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  data      Bytes?
  updatedAt DateTime @updatedAt

  @@map("boards")
}

model ChatMessage {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId       String      @db.Uuid
  space         Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sessionId     String      @db.Uuid
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId String      @db.Uuid
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  senderName    String
  senderRole    ClassRole
  body          String
  createdAt     DateTime    @default(now())

  @@index([spaceId, createdAt])
  @@map("chat_messages")
}
